{
  "name": "muscle-dynamics",
  "version": "1.2.0-full-render",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-source.mjs && npm test",
    "postinstall": "prisma generate",
    "db:sql": "node scripts/export-mariadb-sql.mjs",
    "render:build": "node scripts/render-build.mjs",
    "render:start": "node scripts/render-start.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
