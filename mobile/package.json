    "prebuild:ios": "expo prebuild --platform ios --no-install"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.9.45",
