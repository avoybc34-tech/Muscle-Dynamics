{
  "expo": {
    "name": "Muscle Dynamics",
    "slug": "muscle-dynamics",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muscledynamics.members"
    },
    "android": {
      "package": "com.muscledynamics.members",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080f1b"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 100,
          "backgroundColor": "#101827"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#1762e8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your profile photo or private payment receipt.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "muscle-dynamics"
  }
}
