{
  "expo": {
    "name": "Muscle Dynamics",
    "slug": "muscle-dynamics",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salma.muscledynamics",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourgym.muscledynamics"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment receipt to send securely to your gym for verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d8bc7aaf-8aa1-4b18-8a58-ccb11a9c57d6"
      }
    },
    "owner": "salmanramay97"
  }
}
