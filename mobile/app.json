{
  "expo": {
    "name": "Muscle Dynamics",
    "slug": "muscle-dynamics",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "ios"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourgym.muscledynamics"
    },
    "android": { "package": "com.yourgym.muscledynamics" },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment receipt to send securely to your gym for verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": { "eas": { "projectId": "" } }
  }
}
