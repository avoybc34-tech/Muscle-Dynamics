{
  "expo": {
    "name": "Muscle Dynamics",
    "slug": "muscle-dynamics",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muscledynamics.members"
    },
    "android": {
      "package": "com.muscledynamics.members",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10243F"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a payment receipt to send securely to your gym for verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
